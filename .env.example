# Copy this file to .env.local (never commit .env.local).
# Easiest: leave this empty and set everything in the app under ⚙️ Settings.
# Settings saved in the app win over these values.

# Tutor model (explains, hints, chat). Any OpenAI-compatible provider works.
# TUTOR_PROVIDER is "openai" (OpenAI-compatible, the default) or "anthropic".
TUTOR_PROVIDER=openai
TUTOR_BASE_URL=https://api.deepseek.com
TUTOR_API_KEY=
TUTOR_MODEL=deepseek-flash
# Optional: USD per million tokens, for the cost counter.
TUTOR_PRICE_IN=
TUTOR_PRICE_OUT=

# Grader model (marks short answers). Leave these empty to use the tutor's
# provider and key; GRADER_MODEL alone picks a different model from it.
GRADER_MODEL=
# GRADER_PROVIDER=
# GRADER_BASE_URL=
# GRADER_API_KEY=

# Examples of other providers:
#   OpenAI:     TUTOR_BASE_URL=https://api.openai.com/v1
#   OpenRouter: TUTOR_BASE_URL=https://openrouter.ai/api/v1
#   Gemini:     TUTOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:     TUTOR_BASE_URL=http://localhost:11434/v1   (no key needed)
#   Claude:     TUTOR_PROVIDER=anthropic, TUTOR_BASE_URL=https://api.anthropic.com
